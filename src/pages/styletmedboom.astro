---

<MainLayout title="Friends of Boom">
  <!-- MAIN WRAPPER FOR FRIENDS OF BOOM-SIDEN -->
  <main class="lg:mt-main-top-desktop mt-main-top-mobile">

    <!-- SEKTION DER HOLDER OVERSKRIFT OG BILLEDEGRID -->
    <section class="overflow-hidden">

      <!-- SIDEOVERSKRIFT -->
      <div class="mb-4 px-margin-mobile lg:px-margin-desktop">
        <Heading
          htmlheading="h1"
          size="xlarge"
          weight="bold"
          color="primary"
        >
          Friends of Boom
        </Heading>
      </div>

      <!-- RESPONSIVT GRID MED ALLE LOOK-BILLEDER -->
      <div class="grid grid-cols-6 gap-x-2 gap-y-2 md:grid-cols-8 md:gap-x-4 md:gap-y-3 lg:grid-cols-12 lg:gap-x-8 lg:gap-y-4">
        {images.map((image) => (

          <!-- LINK OMKRING HELE BILLEDEKORTET -->
          <a href={image.link} class={`group relative block ${image.class}`}>

            <!-- BILLEDEWRAPPER MED HOVER-EFFEKT -->
            <div class="relative overflow-hidden">

              <!-- LOOK-BILLEDE -->
              <img
                src={image.src}
                alt={image.title}
                class="block w-full object-cover transition duration-300 md:group-hover:brightness-75"
                loading="lazy"
              />

              <!-- DESKTOP HOVER-OVERLAY MED PRODUKTTITEL OG PIL -->
              <div class="absolute inset-0 hidden items-end opacity-0 transition duration-300 group-hover:opacity-100 md:flex">
                <div class="flex w-full items-center justify-between px-4 py-4">

                  <!-- PRODUKTTITEL PÅ DESKTOP HOVER -->
                  <Heading
                    htmlheading="h5"
                    size="xsmall"
                    weight="semibold"
                    color="secondary"
                  >
                    {image.title}
                  </Heading>

                  <!-- PIL PÅ DESKTOP HOVER -->
                  <img
                    src="arrow.svg"
                    alt=""
                    class="w-10 invert"
                  />

                </div>
              </div>

              <!-- MOBILTEKST UNDER BILLEDET -->
              <div class="mt-2 flex items-center justify-between px-1 md:hidden">

                <!-- PRODUKTTITEL PÅ MOBIL -->
                <Heading
                  htmlheading="h5"
                  size="xsmall"
                  weight="semibold"
                  color="primary"
                >
                  {image.title}
                </Heading>

                <!-- PIL PÅ MOBIL -->
                <img
                  src="arrow.svg"
                  alt=""
                  class="w-6"
                />

              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</MainLayout>