---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import ProductCard from "../components/ProductCard.astro";
import { fetchProducts } from "../lib/supabase";

// HENT ALLE PRODUKTER FRA SUPABASE
const products = await fetchProducts();
---

<MainLayout title="Boom Butik">
  <main>
    <div id="next-section" class="pt-margin-mobile px-margin-mobile lg:px-margin-desktop">
      <!-- HERO-SEKTION MED VIDEO -->
      <section class="relative">
        <!-- HERO VIDEO -->
        <video autoplay muted loop playsinline class="w-full h-125 lg:h-140 object-cover">
          <source src="/Hero_4.mp4" type="video/mp4" />
        </video>

        <!-- GRADIENT OVERLAY -->
        <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

        <!-- HERO CONTENT -->
        <div class="absolute bottom-0 left-0 p-6 space-y-3">
          <Heading htmlheading="h2" size="large" weight="semibold" color="secondary">TØJET ER DIT BLANKE LÆRRED</Heading>
          <Heading htmlheading="h2" size="large" weight="semibold" color="secondary"> DU UDFYLDER DET</Heading>

          <a href="/listview">
            <Button variant="primary" size="small">SHOP NU →</Button>
          </a>
        </div>
      </section>

      <!-- FØRSTE PRODUKTSEKTION -->
      <section class="mt-2 mb-5 lg:mb-8">
        <!-- MOBIL: HORISONTAL PRODUKTCAROUSEL -->
        <div class="md:hidden flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 scrollbar-hide">
          {
            products.slice(0, 4).map((product: any) => (
              <div class="shrink-0 w-3/4 snap-start">
                <ProductCard product={product} />
              </div>
            ))
          }
        </div>

        <!-- DESKTOP: PRODUKTGRID -->
        <div class="hidden md:grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-grid-gap-desktop">
          {products.slice(0, 4).map((product: any) => <ProductCard product={product} />)}
        </div>
      </section>

      <!-- MOBILE CAROUSEL MED BRANDSEKTIONER -->
      <section class="md:hidden flex gap-2 overflow-x-auto snap-x snap-mandatory scrollbar-hide mt-2">
        <!-- MOBILE CARD 1 -->
        <div class="relative overflow-hidden shrink-0 w-[85%] snap-start">
          <img loading="lazy" src="/tøjstativ.webp" alt="Tøjstativ" class="w-full h-125 object-cover" />

          <!-- GRADIENT OVERLAY -->
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

          <!-- CARD CONTENT -->
          <div class="absolute bottom-0 left-0 p-6 space-y-3">
            <Heading htmlheading="h3" size="medium" weight="semibold" color="secondary"> ET STYKKE SIMPELT TØJ </Heading>

            <a href="/om-os">
              <Button variant="secondary" size="small">OM OS →</Button>
            </a>
          </div>
        </div>

        <!-- MOBILE CARD 2 -->
        <div class="relative overflow-hidden shrink-0 w-[85%] snap-start">
          <img loading="lazy" src="/astridolsen.webp" alt="Styling inspiration" class="w-full h-125 object-cover" />

          <!-- GRADIENT OVERLAY -->
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

          <!-- CARD CONTENT -->
          <div class="absolute bottom-0 left-0 p-6 space-y-3">
            <Heading htmlheading="h3" size="medium" weight="semibold" color="secondary"> TILFØJ DIT PERSONLIGE UDTRYK </Heading>

            <a href="/styletmedboom">
              <Button variant="secondary" size="small">STYLET MED BOOM →</Button>
            </a>
          </div>
        </div>
      </section>

      <!-- DESKTOP GRID MED BRANDSEKTIONER -->
      <section class="hidden md:grid grid-cols-2 mt-2 gap-2">
        <!-- DESKTOP CARD 1 -->
        <div class="relative overflow-hidden">
          <img loading="lazy" src="/tøjstativ.webp" alt="Tøjstativ" class="w-full h-160 object-cover" />

          <!-- GRADIENT OVERLAY -->
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

          <!-- CARD CONTENT -->
          <div class="absolute bottom-0 left-0 p-6 space-y-3">
            <Heading htmlheading="h3" size="medium" weight="semibold" color="secondary"> ET STYKKE SIMPELT TØJ </Heading>

            <a href="/om-os">
              <Button variant="secondary" size="small">OM OS →</Button>
            </a>
          </div>
        </div>

        <!-- DESKTOP CARD 2 -->
        <div class="relative overflow-hidden">
          <img loading="lazy" src="/astridolsen.webp" alt="Styling inspiration" class="w-full h-160 object-cover" />

          <!-- GRADIENT OVERLAY -->
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

          <!-- CARD CONTENT -->
          <div class="absolute bottom-0 left-0 p-6 space-y-3">
            <Heading htmlheading="h3" size="medium" weight="semibold" color="secondary"> TILFØJ DIT PERSONLIGE UDTRYK </Heading>

            <a href="/styletmedboom">
              <Button variant="secondary" size="small">STYLET MED BOOM →</Button>
            </a>
          </div>
        </div>
      </section>

      <!-- ANDEN PRODUKTSEKTION -->
      <section class="mt-2 mb-5 lg:mb-8">
        <!-- MOBIL: HORISONTAL PRODUKTCAROUSEL -->
        <div class="md:hidden flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 scrollbar-hide">
          {
            products.slice(4, 8).map((product: any) => (
              <div class="shrink-0 w-3/4 snap-start">
                <ProductCard product={product} />
              </div>
            ))
          }
        </div>

        <!-- DESKTOP: PRODUKTGRID -->
        <div class="hidden md:grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-grid-gap-desktop">
          {products.slice(4, 8).map((product: any) => <ProductCard product={product} />)}
        </div>
      </section>

      <!-- FYSISK BUTIK SEKTION -->
      <section class="relative mt-2">
        <!-- BUTIK IMAGE -->
        <img loading="lazy" src="/butik.webp" alt="Boom Butiks fysiske butik" class="w-full h-125 md:h-160 object-cover" />

        <!-- GRADIENT OVERLAY -->
        <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>

        <!-- BUTIK CONTENT -->
        <div class="absolute bottom-0 left-0 p-6 space-y-3">
          <Heading htmlheading="h3" size="medium" weight="semibold" color="secondary"> BESØG VORES FYSISKE BUTIK </Heading>

          <Text color="secondary">
            Blågårdsgade 14, 2200 København N<br />
            Åbent alle dage 12.00 - 18.00
          </Text>
        </div>
      </section>
    </div>
  </main>
</MainLayout>
